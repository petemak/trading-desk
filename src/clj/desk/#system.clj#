(ns desk.system
  "Assembles the three Component records (config, engine, pedestal) into
  one system. `config` is a plain Aero-loaded map validated against
  `desk.schema/Config`; `engine` and `pedestal` are Component records that
  depend on it (and, for `pedestal`, on `engine` too) via
  `component/using`."
  (:require [clojure.java.io :as io]
            [com.stuartsierra.component :as component]
            [aero.core :as aero]
            [malli.core :as m]
            [malli.error :as me]
            [desk.schema :as schema]
            [desk.engine :as engine]
            [desk.server :as server])
  (:gen-class))

(defn- env-profile []
  (or (some-> (System/getenv "DESK_ENV") keyword) :dev))

(defn read-raw-config
  "Aero-loads resources/config.edn for the given profile, unvalidated."
  [profile]
  (aero/read-config (io/resource "config.edn") {:profile profile}))

(defn validate-config
  "Validates `cfg` against `schema/Config`. Returns `cfg` unchanged when
  valid; throws `ex-info` with a humanized (malli.error/humanize) message
  when it doesn't match -- config.edn must not silently reach the running
  system in a malformed shape."
  [cfg]
  (if (m/validate schema/Config cfg)
    cfg
    (let [errors (me/humanize (m/explain schema/Config cfg))]
      (throw (ex-info (str "Invalid config: " (pr-str errors))
                       {:errors errors :config cfg})))))

(defn config
  "Load and validate config for `profile` (default `:dev`, or `DESK_ENV`
  when set)."
  ([] (config (env-profile))))
([profile] (validate-config (read-raw-config profile)))

(defn new-system
  ([] (new-system (env-profile)))
  ([profile]
   (component/system-map
    :config (config profile)
    :engine (component/using (engine/new-engine) [:config])
    :pedestal (component/using (server/new-server) [:config :engine]))))

(defn -main [& _args]
  (component/start (new-system (env-profile))))
